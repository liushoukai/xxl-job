# k8sdeploy overrides. Everything else is inferred from the jpack package.

# fat jar package: manager.sh has no MAIN_CLASS, so launch through the boot loader on lib/*.jar
MAIN_CLASS=org.springframework.boot.loader.launch.JarLauncher

# bin/jvm.options pins -Dserver.port=9100, which beats the 8080 in conf/application.properties
PORT=9100

# conf/application.properties says "/", application-k8sdev.yml moves it to /xxl-job-admin
CONTEXT_PATH=/xxl-job-admin

# application-k8sdev.yml holds the in-cluster settings
APP_ENV=k8sdev
